APP_NAME=ResearchHub
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# PostgreSQL (or set DB_CONNECTION=mysql and the MySQL port/credentials)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=researchhub
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
CACHE_STORE=redis

# All AI generation and analysis runs on Redis queues processed by Horizon
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Private uploads: "local" in development, "s3" (any S3-compatible service) in production
RESEARCHHUB_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Payments (Paystack) ---------------------------------------------------
# Paystack (project payments). Test keys from https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=sk_test_a2081a16c00ec607ce3810b28cf7209ae77cce0c
PAYSTACK_PUBLIC_KEY=pk_test_58364cd6b1a6df6e2e3c70cbae41184e2bd758ca
PAYSTACK_CHANNELS=card,mobile_money
PAYMENT_CURRENCY=GHS
# Default prices per research type (admins can change them in the dashboard)
PRICE_UNDERGRADUATE=300
PRICE_MBA=600
PRICE_MPHIL=800
PRICE_PHD=1500

# --- Claude (Anthropic API): used only for title suggestions -------------------
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
CLAUDE_MAX_TOKENS=4000
CLAUDE_TIMEOUT=45
# Set to true to use built-in sample titles and no API key
CLAUDE_FAKE=false
# Title suggestion requests allowed per researcher per hour (also 5 per minute)
TITLE_SUGGESTIONS_PER_HOUR=20

# --- Submissions and uploads ----------------------------------------------------
# Source files a researcher must upload before submitting
MIN_SOURCES=1
PAPER_MAX_COUNT=60
# Per-file limits in KB (PHP's upload_max_filesize and post_max_size must be at least this)
PAPER_MAX_KB=32768
DATASET_MAX_KB=32768
TRANSCRIPT_MAX_KB=32768
DELIVERABLE_MAX_KB=32768

# auto | vite | cdn  (auto uses the compiled build when it exists, otherwise the Tailwind CDN like the designs)
TAILWIND_ASSETS=auto

VITE_APP_NAME="${APP_NAME}"
HORIZON_ADMINS=
